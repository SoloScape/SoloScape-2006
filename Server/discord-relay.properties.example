# Copy this file to discord-relay.properties and fill in your own values.
# The real discord-relay.properties file is ignored by Git so relay keys are not committed.

relay.url=https://your-relay.example/event
relay.key=YOUR_PRIVATE_RELAY_KEY
server.name=My SoloScape

# Optional: extend the built-in boss list.
boss.ids=
boss.names=
